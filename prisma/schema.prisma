generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  phone              String?
  role               String    @default("user") // "user", "affiliate", "admin"
  referralCode       String?   @unique
  referredBy         String?
  
  // Affiliate application
  applicationStatus  String?   // "pending", "approved", "rejected"
  applicationDate    DateTime?
  applicationData    Json?     // Store answers to questions
  
  // Wallet
  walletBalance      Float     @default(0)
  pendingEarnings    Float     @default(0)
  
  // Bank details for withdrawals
  bankName           String?
  accountNumber      String?
  accountTitle       String?
  
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  
  otps               Otp[]
  referralsGiven     Referral[] @relation("Referrer")
  referralReceived   Referral?  @relation("Referred")
  commissions        Commission[]
  withdrawals        WithdrawalRequest[]
  orders             Order[]
}

model Otp {
  id        String   @id @default(cuid())
  code      String
  email     String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@index([email])
  @@index([code, email])
}

model Referral {
  id          String   @id @default(cuid())
  referrerId  String
  referredId  String   @unique
  status      String   @default("signup") // "signup", "purchased", "in_progress", "completed"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  referrer    User     @relation("Referrer", fields: [referrerId], references: [id])
  referred    User     @relation("Referred", fields: [referredId], references: [id])

  @@index([referrerId])
}

model Commission {
  id          String    @id @default(cuid())
  userId      String
  amount      Float
  status      String    @default("pending") // "pending", "available", "withdrawn"
  source      String    // Description of what generated this
  referralId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model WithdrawalRequest {
  id            String    @id @default(cuid())
  userId        String
  amount        Float
  bankName      String
  accountNumber String
  accountTitle  String
  status        String    @default("pending") // "pending", "processing", "completed", "rejected"
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
  notes         String?
  
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model Order {
  id            String   @id @default(cuid())
  userId        String?
  referralCode  String?
  name          String
  email         String
  phone         String
  businessName  String?
  package       String   // "starter", "pro", "enterprise"
  message       String?
  status        String   @default("inquiry") // "inquiry", "confirmed", "in_progress", "completed", "cancelled"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  user          User?    @relation(fields: [userId], references: [id])

  @@index([referralCode])
  @@index([status])
}

model Blog {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String    // Short summary for listing
  content     String    // Full markdown/HTML content
  coverImage  String?   // URL or path to cover image
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, publishedAt])
}
